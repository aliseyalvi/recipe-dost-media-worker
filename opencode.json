{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/worker-context.md"],
  "shell": "/bin/zsh",
  "model": "openrouter/deepseek/deepseek-v4-pro",
  "permission": {
    "edit": "allow",
    "bash": {
      "python -m compileall app": "allow",
      "python3 -m compileall app": "allow",
      "uvicorn *": "allow",
      "pip install *": "allow",
      "source .venv/bin/activate": "allow",
      "curl *": "allow",
      "git *": "allow",
      "docker *": "allow",
      "*": "ask"
    },
    "external_directory": {
      "~/.config/**": "allow",
      "/var/folders/**": "allow",
      "*": "ask"
    },
    "webfetch": "allow"
  },
  "formatter": false,
  "lsp": false,
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": false
    }
  }
}