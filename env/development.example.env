# Copy to env/development.env and fill with development-only values.
# Do not use production Supabase service-role keys in this file.

APP_ENV=development
LOG_LEVEL=debug

SUPABASE_URL=https://your-dev-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-development-service-role-key
MEDIA_WORKER_SHARED_SECRET=replace-with-development-worker-shared-secret
GEMINI_API_KEY=replace-with-development-gemini-api-key
INSTAGRAM_RAPIDAPI_KEY=replace-with-development-instagram-rapidapi-key
TIKTOK_AKNG_ACCESS_TOKEN=replace-with-development-tiktok-akng-token

# Ordinary development monitoring remains disabled. To send the one controlled
# verification event, replace this DSN and temporarily set SENTRY_DEV_TEST=true.
SENTRY_DSN=replace-with-development-sentry-dsn
SENTRY_DEV_TEST=false
SENTRY_DEV_CANARY=false

# Non-secret runtime settings live in config/worker.defaults.json and
# config/worker.development.json. Legacy Render env values still override config
# during the migration window, but new env files should not add them. Resolver
# modes, chains, provider hosts, size limits, and timeouts remain in config JSON.
