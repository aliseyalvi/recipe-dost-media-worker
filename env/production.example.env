# Copy to env/production.env and fill with production-only values.
# Do not use development Supabase service-role keys in this file.

APP_ENV=production
LOG_LEVEL=info

SUPABASE_URL=https://your-prod-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-production-service-role-key
MEDIA_WORKER_SHARED_SECRET=replace-with-production-worker-shared-secret
GEMINI_API_KEY=replace-with-production-gemini-api-key

# Non-secret runtime settings live in config/worker.defaults.json and
# config/worker.production.json. Legacy Render env values still override config
# during the migration window, but new env files should not add them.
